#!/bin/sh

set -e

LC_ALL=C

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Installing required packages"
set +e
pacman -Sy
if [ ! -z "$(pacman -Qq vi 2>/dev/null)" ]; then
	pacman -Rsn --noconfirm "$(pacman -Qq vi 2>/dev/null)"
fi
PKG_LIB="$(pacman -Ssq | grep '^\(linux-headers\|linux-armv7-headers\|linux-aarch64-headers\)$') $(pacman -Sqg base | grep -v '^\(cryptsetup\|device-mapper\|dhcpcd\|jfsutils\|linux\|logrotate\|lvm2\|man-db\|man-pages\|mdadm\|netctl\|pciutils\|pcmciautils\|reiserfsprogs\|s-nail\|systemd-sysvcompat\|usbutils\|xfsprogs\|vi\)$') asp bash-completion pkgfile rsync sudo vim wget unzip zip openssh cpio bc"
PKG_LIB="${PKG_LIB} base-devel gdb git python python-virtualenv python-pip python2 python2-pip subversion distcc ccache cscope ctags arch-install-scripts"
PKG_LIB="${PKG_LIB} su-exec"
if [ "$(uname -m)" = "x86_64" ]; then
	sed -i -e "/^#\[multilib\]/{N; s/#\(\[multilib\]\)\n#\(.*\)$/\1\n\2/g}" /etc/pacman.conf
	PKG_LIB="${PKG_LIB} multilib-devel"
fi
set -e
docker-install -r -u --needed ${PKG_LIB} ${PKG_DEV} --assume-installed linux
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Uninstalling unnecessary packages"
docker-install -d -c ${PKG_DEV}
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Setting basic configurations"
#sed -i -e "s/^#ko_KR.UTF-8/ko_KR.UTF-8/g" /etc/locale.gen
#locale-gen

ln -sf /usr/bin/vim /usr/local/bin/vi

mkdir -p /etc/sudoers.d
ln -sf /usr/local/etc/sudoers /etc/sudoers.d/sudoers

sed -i -e "s/if (( EUID == 0 ))/if (( EUID == -1 ))/g" /usr/bin/makepkg

sed -i -e "s/^#\(Color\)/\1/g" -e "s/#\(VerbosePkgLists\)/\1/g" /etc/pacman.conf

sed -i -e "s/^\(alias\)/#\1/g" -e "s/^\(PS1\)=/#\1=/g" /etc/skel/.bashrc
cp -R /etc/skel/. /root/

if [ "${MACHINE}" = "armv7l" -o "${MACHINE}" = "aarch64" ]; then
	sed -i -e 's@^\(SHELL=/bin/bash\) unshare --fork --pid @\1 @g' /usr/bin/arch-chroot
fi

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

